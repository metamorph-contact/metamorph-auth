{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DestinationReceiptResultV1",
  "type": "object",
  "properties": {
    "capability": {
      "$ref": "#/$defs/HomeFinalizationCapability"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "finalizationAttemptId": {
      "$ref": "#/$defs/Uuid7"
    },
    "identityApiOrigin": {
      "$ref": "#/$defs/Origin"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "finalizationAttemptId",
    "identityApiOrigin",
    "capability",
    "expiresAt"
  ],
  "$defs": {
    "HomeFinalizationCapability": {
      "type": "string",
      "maxLength": 20480,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Origin": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^https?://[^/?#]+$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
