{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrivateCodeExchangeResultV1",
  "type": "object",
  "properties": {
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "outcome": {
      "$ref": "#/$defs/ExchangeOutcome"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcome",
    "expiresAt"
  ],
  "$defs": {
    "ExchangeOutcome": {
      "type": "string",
      "maxLength": 12288,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
