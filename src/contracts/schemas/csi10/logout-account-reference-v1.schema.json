{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogoutAccountReferenceV1",
  "type": "object",
  "properties": {
    "browserAccountId": {
      "$ref": "#/$defs/BrowserAccountId"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "homeRegionId": {
      "$ref": "#/$defs/CatalogId"
    },
    "identityApiOrigin": {
      "$ref": "#/$defs/Origin"
    },
    "metadataCapability": {
      "$ref": "#/$defs/LogoutAccountMetadataCapability"
    }
  },
  "additionalProperties": false,
  "required": [
    "browserAccountId",
    "homeRegionId",
    "identityApiOrigin",
    "metadataCapability",
    "expiresAt"
  ],
  "$defs": {
    "BrowserAccountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    },
    "LogoutAccountMetadataCapability": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Origin": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^https?://[^/?#]+$"
    }
  }
}
