{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HomeLogoutResultV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/HomeLogoutOutcome"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "state": {
          "type": "string",
          "const": "revoked"
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "schemaVersion",
        "outcome"
      ]
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/HomeLogoutOutcome"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "state": {
          "type": "string",
          "const": "alreadyDone"
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "schemaVersion",
        "outcome"
      ]
    },
    {
      "type": "object",
      "properties": {
        "outcome": {
          "$ref": "#/$defs/HomeLogoutOutcome"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "state": {
          "type": "string",
          "const": "retryRequired"
        }
      },
      "additionalProperties": false,
      "required": [
        "state",
        "schemaVersion",
        "outcome"
      ]
    }
  ],
  "$defs": {
    "HomeLogoutOutcome": {
      "type": "string",
      "maxLength": 5120,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
