{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserLogoutOutcomeV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "browserAccountId": {
          "$ref": "#/$defs/BrowserAccountId"
        },
        "kind": {
          "type": "string",
          "const": "account"
        },
        "outcome": {
          "$ref": "#/$defs/HomeLogoutOutcome"
        },
        "state": {
          "$ref": "#/$defs/HomeLogoutResultStateV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "browserAccountId",
        "state",
        "outcome"
      ]
    },
    {
      "type": "object",
      "properties": {
        "cancellationId": {
          "$ref": "#/$defs/Uuid7"
        },
        "kind": {
          "type": "string",
          "const": "cancelAuthority"
        },
        "outcome": {
          "$ref": "#/$defs/BrowserGenerationCancellationOutcome"
        },
        "state": {
          "$ref": "#/$defs/BrowserGenerationCancellationResultStateV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "cancellationId",
        "state",
        "outcome"
      ]
    }
  ],
  "$defs": {
    "BrowserAccountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "BrowserGenerationCancellationOutcome": {
      "type": "string",
      "maxLength": 5120,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "BrowserGenerationCancellationResultStateV1": {
      "type": "string",
      "enum": [
        "cancelled",
        "alreadyDone",
        "retryRequired"
      ]
    },
    "HomeLogoutOutcome": {
      "type": "string",
      "maxLength": 5120,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "HomeLogoutResultStateV1": {
      "type": "string",
      "enum": [
        "revoked",
        "alreadyDone",
        "retryRequired"
      ]
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
