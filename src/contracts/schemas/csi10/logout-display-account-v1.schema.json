{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogoutDisplayAccountV1",
  "type": "object",
  "properties": {
    "browserAccountId": {
      "$ref": "#/$defs/BrowserAccountId"
    },
    "homeRegionId": {
      "$ref": "#/$defs/CatalogId"
    }
  },
  "additionalProperties": false,
  "required": [
    "browserAccountId",
    "homeRegionId"
  ],
  "$defs": {
    "BrowserAccountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    }
  }
}
