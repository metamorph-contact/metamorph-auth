{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogoutResultV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "const": "recoverable"
        },
        "logoutCsrfToken": {
          "$ref": "#/$defs/Secret32"
        },
        "operationId": {
          "$ref": "#/$defs/Uuid7"
        },
        "recoveryAction": {
          "$ref": "#/$defs/RecoveryActionV1"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/ProductLogoutRecoverableStateV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "operationId",
        "state",
        "logoutCsrfToken",
        "expiresAt",
        "recoveryAction"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "terminal"
        },
        "operationId": {
          "$ref": "#/$defs/Uuid7"
        },
        "recoveryAction": {
          "$ref": "#/$defs/RecoveryActionV1"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "state": {
          "$ref": "#/$defs/ProductLogoutTerminalStateV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "operationId",
        "state",
        "recoveryAction"
      ]
    }
  ],
  "$defs": {
    "ProductLogoutRecoverableStateV1": {
      "type": "string",
      "enum": [
        "prepared"
      ]
    },
    "ProductLogoutTerminalStateV1": {
      "type": "string",
      "enum": [
        "notCommitted",
        "revoked",
        "alreadyDone",
        "failed"
      ]
    },
    "RecoveryActionV1": {
      "type": "string",
      "enum": [
        "retrySameOperation",
        "retryInput",
        "retryCredentials",
        "enterCredentials",
        "useExistingAccount",
        "restartWithRequiredAssurance",
        "restartProductAuth",
        "finishFirstActivation",
        "repairProductSession",
        "reauthenticate",
        "retainCurrentSession",
        "retryLogout",
        "acknowledgeComplete",
        "acknowledgeCleanupPage",
        "signInFresh",
        "retainAccountCapsule",
        "restoreSource",
        "refreshCatalog",
        "none"
      ]
    },
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
