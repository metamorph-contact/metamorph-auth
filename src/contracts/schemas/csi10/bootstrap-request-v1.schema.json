{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BootstrapRequestV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "expectedTabTransactionId": {
          "$ref": "#/$defs/Secret32"
        },
        "kind": {
          "type": "string",
          "const": "returnSameTab"
        },
        "returnReceipt": {
          "$ref": "#/$defs/ProductSuccessReceipt"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "returnReceipt",
        "expectedTabTransactionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "returnFreshTab"
        },
        "returnReceipt": {
          "$ref": "#/$defs/ProductSuccessReceipt"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "returnReceipt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "accountSlotId": {
          "$ref": "#/$defs/Uuid7"
        },
        "kind": {
          "type": "string",
          "const": "ordinary"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "accountSlotId"
      ]
    }
  ],
  "$defs": {
    "ProductSuccessReceipt": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
