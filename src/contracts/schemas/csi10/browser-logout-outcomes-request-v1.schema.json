{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserLogoutOutcomesRequestV1",
  "type": "object",
  "properties": {
    "logoutCsrfToken": {
      "$ref": "#/$defs/Secret32"
    },
    "operationId": {
      "$ref": "#/$defs/Uuid7"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/BrowserLogoutOutcomeV1"
      },
      "maxItems": 2,
      "minItems": 1
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "workPageId": {
      "$ref": "#/$defs/Uuid7"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "logoutCsrfToken",
    "workPageId",
    "outcomes"
  ],
  "$defs": {
    "BrowserAccountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "BrowserGenerationCancellationOutcome": {
      "type": "string",
      "maxLength": 5120,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "BrowserGenerationCancellationResultV1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/BrowserGenerationCancellationOutcome"
            },
            "schemaVersion": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "schemaVersion",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/BrowserGenerationCancellationOutcome"
            },
            "schemaVersion": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "alreadyDone"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "schemaVersion",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/BrowserGenerationCancellationOutcome"
            },
            "schemaVersion": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "retryRequired"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "schemaVersion",
            "outcome"
          ]
        }
      ]
    },
    "BrowserLogoutOutcomeV1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "browserAccountId": {
              "$ref": "#/$defs/BrowserAccountId"
            },
            "kind": {
              "type": "string",
              "const": "account"
            },
            "result": {
              "$ref": "#/$defs/HomeLogoutResultV1"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "browserAccountId",
            "result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "cancellationId": {
              "$ref": "#/$defs/Uuid7"
            },
            "kind": {
              "type": "string",
              "const": "cancelAuthority"
            },
            "result": {
              "$ref": "#/$defs/BrowserGenerationCancellationResultV1"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "cancellationId",
            "result"
          ]
        }
      ]
    },
    "HomeLogoutOutcome": {
      "type": "string",
      "maxLength": 5120,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "HomeLogoutResultV1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/HomeLogoutOutcome"
            },
            "schemaVersion": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "revoked"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "schemaVersion",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/HomeLogoutOutcome"
            },
            "schemaVersion": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "alreadyDone"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "schemaVersion",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "$ref": "#/$defs/HomeLogoutOutcome"
            },
            "schemaVersion": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "retryRequired"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "schemaVersion",
            "outcome"
          ]
        }
      ]
    },
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
