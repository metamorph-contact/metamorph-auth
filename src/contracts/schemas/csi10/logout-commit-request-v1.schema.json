{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogoutCommitRequestV1",
  "type": "object",
  "properties": {
    "logoutCsrfToken": {
      "$ref": "#/$defs/Secret32"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "logoutCsrfToken"
  ],
  "$defs": {
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
