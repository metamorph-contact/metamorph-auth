{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserLogoutCompleteAcknowledgementV1",
  "type": "object",
  "properties": {
    "logoutCsrfToken": {
      "$ref": "#/$defs/Secret32"
    },
    "operationId": {
      "$ref": "#/$defs/Uuid7"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operationId",
    "logoutCsrfToken"
  ],
  "$defs": {
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
