{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogoutAccountTerminalV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "browserAccountId": {
          "$ref": "#/$defs/BrowserAccountId"
        },
        "kind": {
          "type": "string",
          "const": "done"
        },
        "state": {
          "$ref": "#/$defs/LogoutAccountTerminalStateV1"
        },
        "terminalEvidenceDigest": {
          "$ref": "#/$defs/Digest32"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "browserAccountId",
        "state",
        "terminalEvidenceDigest"
      ]
    }
  ],
  "$defs": {
    "BrowserAccountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "Digest32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "LogoutAccountTerminalStateV1": {
      "type": "string",
      "enum": [
        "revoked",
        "alreadyDone",
        "authorityExpired"
      ]
    }
  }
}
