{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserLogoutPrepareRequestV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "flowId": {
          "$ref": "#/$defs/Uuid7"
        },
        "head": {
          "$ref": "#/$defs/BrowserHeadReferenceV1"
        },
        "prepareAttemptId": {
          "$ref": "#/$defs/Secret32"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "const": "identityFlow"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "schemaVersion",
        "prepareAttemptId",
        "flowId",
        "head"
      ]
    },
    {
      "type": "object",
      "properties": {
        "browserAccountId": {
          "$ref": "#/$defs/BrowserAccountId"
        },
        "head": {
          "$ref": "#/$defs/BrowserHeadReferenceV1"
        },
        "prepareAttemptId": {
          "$ref": "#/$defs/Secret32"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "const": "identityAccount"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "schemaVersion",
        "prepareAttemptId",
        "browserAccountId",
        "head"
      ]
    },
    {
      "type": "object",
      "properties": {
        "head": {
          "$ref": "#/$defs/BrowserHeadReferenceV1"
        },
        "prepareAttemptId": {
          "$ref": "#/$defs/Secret32"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "scope": {
          "type": "string",
          "const": "identityBrowserAll"
        }
      },
      "additionalProperties": false,
      "required": [
        "scope",
        "schemaVersion",
        "prepareAttemptId",
        "head"
      ]
    }
  ],
  "$defs": {
    "BrowserAccountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "BrowserHeadId": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "BrowserHeadReferenceV1": {
      "type": "object",
      "properties": {
        "browserHeadId": {
          "$ref": "#/$defs/BrowserHeadId"
        },
        "browserInitializationId": {
          "$ref": "#/$defs/BrowserInitializationId"
        },
        "placement": {
          "$ref": "#/$defs/ControllerPlacementV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "browserHeadId",
        "browserInitializationId",
        "placement"
      ]
    },
    "BrowserInitializationId": {
      "type": "string",
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    },
    "CatalogVersion": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "ControllerPlacementV1": {
      "type": "object",
      "properties": {
        "algorithmVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "catalogDigest": {
          "$ref": "#/$defs/Digest32"
        },
        "catalogVersion": {
          "$ref": "#/$defs/CatalogVersion"
        },
        "controllerRegionId": {
          "$ref": "#/$defs/CatalogId"
        }
      },
      "additionalProperties": false,
      "required": [
        "algorithmVersion",
        "catalogVersion",
        "catalogDigest",
        "controllerRegionId"
      ]
    },
    "Digest32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
