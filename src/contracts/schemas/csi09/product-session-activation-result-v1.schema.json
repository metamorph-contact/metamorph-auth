{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductSessionActivationResultV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "accountSlotId": {
          "$ref": "#/$defs/Uuid7"
        },
        "kind": {
          "type": "string",
          "const": "activated"
        },
        "regionId": {
          "$ref": "#/$defs/CatalogId"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "accountSlotId",
        "regionId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "discarded"
        },
        "recoveryAction": {
          "$ref": "#/$defs/ProductActivationRecoveryActionV1"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "recoveryAction"
      ]
    }
  ],
  "$defs": {
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    },
    "ProductActivationRecoveryActionV1": {
      "type": "string",
      "enum": [
        "restartProductAuth"
      ]
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
