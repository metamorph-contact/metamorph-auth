{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductSessionRepairResultV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "const": "repaired"
        },
        "regionId": {
          "$ref": "#/$defs/CatalogId"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "regionId",
        "expiresAt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "restartRequired"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion"
      ]
    }
  ],
  "$defs": {
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    }
  }
}
