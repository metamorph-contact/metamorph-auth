{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecoveryChallengeBindingV1",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "#/$defs/RecoveryContext"
    },
    "preview": {
      "$ref": "#/$defs/EmailLinkPreview"
    }
  },
  "additionalProperties": false,
  "required": [
    "context",
    "preview"
  ],
  "$defs": {
    "EmailLinkPreview": {
      "type": "string",
      "maxLength": 2048,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RecoveryContext": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
