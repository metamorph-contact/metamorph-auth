{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialRouteResolutionV1",
  "type": "object",
  "properties": {
    "attemptId": {
      "$ref": "#/$defs/Uuid7"
    },
    "catalogVersion": {
      "$ref": "#/$defs/CatalogVersion"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "homeSeed": {
      "$ref": "#/$defs/CredentialRouteSeed"
    },
    "identityApiOrigin": {
      "$ref": "#/$defs/Origin"
    },
    "kind": {
      "$ref": "#/$defs/RouteKindV1"
    },
    "operationId": {
      "$ref": "#/$defs/Uuid7"
    },
    "regionId": {
      "$ref": "#/$defs/CatalogId"
    },
    "routeDecision": {
      "$ref": "#/$defs/RouteDecision"
    },
    "routeEpoch": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "regionId",
    "identityApiOrigin",
    "routeEpoch",
    "catalogVersion",
    "attemptId",
    "operationId",
    "routeDecision",
    "homeSeed",
    "expiresAt"
  ],
  "$defs": {
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    },
    "CatalogVersion": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "CredentialRouteSeed": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Origin": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^https?://[^/?#]+$"
    },
    "RouteDecision": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RouteKindV1": {
      "type": "string",
      "enum": [
        "route"
      ]
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
