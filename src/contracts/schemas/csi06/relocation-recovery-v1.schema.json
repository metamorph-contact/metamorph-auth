{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RelocationRecoveryV1",
  "type": "object",
  "properties": {
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "navigationUri": {
      "type": "string"
    },
    "successorFlowId": {
      "$ref": "#/$defs/Uuid7"
    }
  },
  "additionalProperties": false,
  "required": [
    "navigationUri",
    "successorFlowId",
    "expiresAt"
  ],
  "$defs": {
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
