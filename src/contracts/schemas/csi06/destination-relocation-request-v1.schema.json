{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DestinationRelocationRequestV1",
  "type": "object",
  "properties": {
    "capability": {
      "$ref": "#/$defs/DestinationRelocation"
    },
    "relayBindingId": {
      "$ref": "#/$defs/Secret32"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability",
    "relayBindingId"
  ],
  "$defs": {
    "DestinationRelocation": {
      "type": "string",
      "maxLength": 8192,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
