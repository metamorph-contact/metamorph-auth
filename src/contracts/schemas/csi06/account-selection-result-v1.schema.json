{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountSelectionResultV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "const": "relocate"
        },
        "navigationUri": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "navigationUri",
        "expiresAt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/Uuid7"
        },
        "capability": {
          "$ref": "#/$defs/AccountAuthorizationCapability"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "identityApiOrigin": {
          "$ref": "#/$defs/Origin"
        },
        "kind": {
          "type": "string",
          "const": "authorize"
        },
        "registrationProof": {
          "$ref": "#/$defs/RemoteOperationRegistrationProof"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "attemptId",
        "identityApiOrigin",
        "capability",
        "registrationProof",
        "expiresAt"
      ]
    }
  ],
  "$defs": {
    "AccountAuthorizationCapability": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Origin": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^https?://[^/?#]+$"
    },
    "RemoteOperationRegistrationProof": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
