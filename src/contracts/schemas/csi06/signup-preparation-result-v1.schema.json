{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignupPreparationResultV1",
  "type": "object",
  "properties": {
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "preparationReceipt": {
      "$ref": "#/$defs/SignupPreparationReceipt"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "preparationReceipt",
    "expiresAt"
  ],
  "$defs": {
    "SignupPreparationReceipt": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
