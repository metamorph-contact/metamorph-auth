{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EmailLinkPreviewRequestV1",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "#/$defs/HomeVerificationContext"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "token": {
      "$ref": "#/$defs/Secret32"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "token",
    "context"
  ],
  "$defs": {
    "HomeVerificationContext": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    }
  }
}
