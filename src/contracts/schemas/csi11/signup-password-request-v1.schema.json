{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignupPasswordRequestV1",
  "type": "object",
  "properties": {
    "password": {
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/SignupContinuationBindingV1"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "password",
    "protocol"
  ],
  "$defs": {
    "RemoteOperationRegistrationProof": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "SignupContinuationBindingV1": {
      "type": "object",
      "properties": {
        "continuationCapability": {
          "$ref": "#/$defs/SignupContinuationCapability"
        },
        "registrationProof": {
          "$ref": "#/$defs/RemoteOperationRegistrationProof"
        }
      },
      "additionalProperties": false,
      "required": [
        "continuationCapability",
        "registrationProof"
      ]
    },
    "SignupContinuationCapability": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
