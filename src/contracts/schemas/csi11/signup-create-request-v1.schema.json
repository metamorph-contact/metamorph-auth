{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignupCreateRequestV1",
  "type": "object",
  "properties": {
    "email": {
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/SignupInitiationBindingV1"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "email",
    "protocol"
  ],
  "$defs": {
    "RegionalCredentialCapability": {
      "type": "string",
      "maxLength": 8192,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RemoteOperationRegistrationProof": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "SignupInitiationBindingV1": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/RegionalCredentialCapability"
        },
        "preparationReceipt": {
          "$ref": "#/$defs/SignupPreparationReceipt"
        },
        "registrationProof": {
          "$ref": "#/$defs/RemoteOperationRegistrationProof"
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "preparationReceipt",
        "registrationProof"
      ]
    },
    "SignupPreparationReceipt": {
      "type": "string",
      "maxLength": 12288,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
