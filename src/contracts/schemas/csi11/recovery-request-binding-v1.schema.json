{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecoveryRequestBindingV1",
  "type": "object",
  "properties": {
    "capability": {
      "$ref": "#/$defs/RegionalCredentialCapability"
    }
  },
  "additionalProperties": false,
  "required": [
    "capability"
  ],
  "$defs": {
    "RegionalCredentialCapability": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
