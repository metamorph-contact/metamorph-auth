{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignupResendRequestV1",
  "type": "object",
  "properties": {
    "protocol": {
      "$ref": "#/$defs/SignupInitiationBindingV1"
    },
    "resendAttemptId": {
      "$ref": "#/$defs/Uuid7"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resendAttemptId",
    "protocol"
  ],
  "$defs": {
    "RegionalCredentialCapability": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RemoteOperationRegistrationProof": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "SignupInitiationBindingV1": {
      "type": "object",
      "properties": {
        "capability": {
          "$ref": "#/$defs/RegionalCredentialCapability"
        },
        "preparationReceipt": {
          "$ref": "#/$defs/SignupPreparationReceipt"
        },
        "registrationProof": {
          "$ref": "#/$defs/RemoteOperationRegistrationProof"
        }
      },
      "additionalProperties": false,
      "required": [
        "capability",
        "preparationReceipt",
        "registrationProof"
      ]
    },
    "SignupPreparationReceipt": {
      "type": "string",
      "maxLength": 12288,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
