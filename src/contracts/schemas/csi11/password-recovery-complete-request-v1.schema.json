{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PasswordRecoveryCompleteRequestV1",
  "type": "object",
  "properties": {
    "completionAttemptId": {
      "$ref": "#/$defs/Uuid7"
    },
    "newPassword": {
      "type": "string"
    },
    "protocol": {
      "$ref": "#/$defs/RecoveryChallengeBindingV1"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "token": {
      "$ref": "#/$defs/LookupCredentialV1"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "token",
    "newPassword",
    "completionAttemptId",
    "protocol"
  ],
  "$defs": {
    "EmailLinkPreview": {
      "type": "string",
      "maxLength": 2048,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "LookupCredentialV1": {
      "type": "string",
      "maxLength": 49,
      "minLength": 46,
      "pattern": "^k[1-9a-z][0-9a-z]{0,3}\\.[A-Za-z0-9_-]{43}$"
    },
    "RecoveryChallengeBindingV1": {
      "type": "object",
      "properties": {
        "context": {
          "$ref": "#/$defs/RecoveryContext"
        },
        "preview": {
          "$ref": "#/$defs/EmailLinkPreview"
        }
      },
      "additionalProperties": false,
      "required": [
        "context",
        "preview"
      ]
    },
    "RecoveryContext": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
