{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PasswordRecoveryResolveRequestV1",
  "type": "object",
  "properties": {
    "context": {
      "$ref": "#/$defs/RecoveryContext"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "token": {
      "$ref": "#/$defs/LookupCredentialV1"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "token",
    "context"
  ],
  "$defs": {
    "LookupCredentialV1": {
      "type": "string",
      "maxLength": 49,
      "minLength": 46,
      "pattern": "^k[1-9a-z][0-9a-z]{0,3}\\.[A-Za-z0-9_-]{43}$"
    },
    "RecoveryContext": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
