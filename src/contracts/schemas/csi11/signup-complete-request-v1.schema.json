{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignupCompleteRequestV1",
  "type": "object",
  "properties": {
    "completeAttemptId": {
      "$ref": "#/$defs/Uuid7"
    },
    "privacyAcknowledgement": {
      "description": "The privacy owner issues this only after a purpose/version-bound\npresentation and acknowledgement. None is valid only when no required\nsignup policy applies; the Plan 11 owner enforces that condition.",
      "anyOf": [
        {
          "$ref": "#/$defs/SignupPrivacyAcknowledgementHandoffV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "profile": {
      "$ref": "#/$defs/SignupProfileV1"
    },
    "protocol": {
      "$ref": "#/$defs/SignupContinuationBindingV1"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "completeAttemptId",
    "profile",
    "protocol"
  ],
  "$defs": {
    "Digest32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "RemoteOperationRegistrationProof": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "SignupContinuationBindingV1": {
      "type": "object",
      "properties": {
        "continuationCapability": {
          "$ref": "#/$defs/SignupContinuationCapability"
        },
        "registrationProof": {
          "$ref": "#/$defs/RemoteOperationRegistrationProof"
        }
      },
      "additionalProperties": false,
      "required": [
        "continuationCapability",
        "registrationProof"
      ]
    },
    "SignupContinuationCapability": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "SignupPrivacyAcknowledgementHandoffV1": {
      "type": "object",
      "properties": {
        "acknowledgementReceiptId": {
          "$ref": "#/$defs/Uuid7"
        },
        "actorBindingDigest": {
          "$ref": "#/$defs/Digest32"
        },
        "ceremonyId": {
          "$ref": "#/$defs/Uuid7"
        },
        "policy": {
          "$ref": "#/$defs/SignupPrivacyPolicyReferenceV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "policy",
        "ceremonyId",
        "acknowledgementReceiptId",
        "actorBindingDigest"
      ]
    },
    "SignupPrivacyAcknowledgementPurposeV1": {
      "type": "string",
      "enum": [
        "required_notice",
        "freely_given_consent"
      ]
    },
    "SignupPrivacyPolicyReferenceV1": {
      "type": "object",
      "properties": {
        "policyId": {
          "$ref": "#/$defs/Uuid7"
        },
        "policyVersion": {
          "$ref": "#/$defs/VersionU64"
        },
        "presentationDigest": {
          "$ref": "#/$defs/Digest32"
        },
        "purpose": {
          "$ref": "#/$defs/SignupPrivacyAcknowledgementPurposeV1"
        }
      },
      "additionalProperties": false,
      "required": [
        "policyId",
        "policyVersion",
        "purpose",
        "presentationDigest"
      ]
    },
    "SignupProfileV1": {
      "type": "object",
      "properties": {
        "avatarColor": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "lastName": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "firstName",
        "handle",
        "avatarColor"
      ]
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "VersionU64": {
      "type": "string",
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,19}$"
    }
  }
}
