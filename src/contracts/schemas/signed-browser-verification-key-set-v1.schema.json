{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignedBrowserVerificationKeySetV1",
  "type": "object",
  "properties": {
    "payload": {
      "$ref": "#/$defs/BrowserVerificationKeySetV1"
    },
    "proof": {
      "$ref": "#/$defs/CatalogSignatureV1"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "payload",
    "proof"
  ],
  "$defs": {
    "BrowserVerificationKeySetV1": {
      "type": "object",
      "properties": {
        "catalogVersion": {
          "$ref": "#/$defs/CatalogVersion"
        },
        "expiresAt": {
          "$ref": "#/$defs/UtcInstant"
        },
        "keySetDigest": {
          "$ref": "#/$defs/Digest32"
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BrowserVerificationKeyV1"
          },
          "maxItems": 256,
          "minItems": 1
        },
        "publishedAt": {
          "$ref": "#/$defs/UtcInstant"
        },
        "realmCatalogDigest": {
          "$ref": "#/$defs/Digest32"
        },
        "realmId": {
          "$ref": "#/$defs/CatalogId"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "realmId",
        "catalogVersion",
        "realmCatalogDigest",
        "keySetDigest",
        "keys",
        "publishedAt",
        "expiresAt"
      ]
    },
    "BrowserVerificationKeyV1": {
      "type": "object",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/Es256AlgorithmV1"
        },
        "emergencyDenied": {
          "type": "boolean"
        },
        "issuerId": {
          "$ref": "#/$defs/CatalogId"
        },
        "keyId": {
          "$ref": "#/$defs/CatalogId"
        },
        "notBefore": {
          "$ref": "#/$defs/UtcInstant"
        },
        "productId": {
          "anyOf": [
            {
              "$ref": "#/$defs/CatalogId"
            },
            {
              "type": "null"
            }
          ]
        },
        "publicJwk": {
          "$ref": "#/$defs/EcP256PublicJwkV1"
        },
        "purpose": {
          "$ref": "#/$defs/BrowserVerificationPurposeV1"
        },
        "regionId": {
          "$ref": "#/$defs/CatalogId"
        },
        "verifyUntil": {
          "$ref": "#/$defs/UtcInstant"
        }
      },
      "additionalProperties": false,
      "required": [
        "issuerId",
        "regionId",
        "purpose",
        "keyId",
        "algorithm",
        "publicJwk",
        "notBefore",
        "verifyUntil",
        "emergencyDenied"
      ]
    },
    "BrowserVerificationPurposeV1": {
      "type": "string",
      "enum": [
        "controllerReceipt",
        "identityReceipt",
        "productSaasReceipt"
      ]
    },
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    },
    "CatalogSignatureV1": {
      "type": "object",
      "properties": {
        "algorithm": {
          "$ref": "#/$defs/Es256AlgorithmV1"
        },
        "keyId": {
          "$ref": "#/$defs/CatalogId"
        },
        "signature": {
          "$ref": "#/$defs/Signature64"
        }
      },
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "signature"
      ]
    },
    "CatalogVersion": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]{1,64}$"
    },
    "Digest32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "EcKeyTypeV1": {
      "type": "string",
      "enum": [
        "EC"
      ]
    },
    "EcP256PublicJwkV1": {
      "type": "object",
      "properties": {
        "crv": {
          "$ref": "#/$defs/P256CurveV1"
        },
        "kty": {
          "$ref": "#/$defs/EcKeyTypeV1"
        },
        "x": {
          "$ref": "#/$defs/Digest32"
        },
        "y": {
          "$ref": "#/$defs/Digest32"
        }
      },
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "x",
        "y"
      ]
    },
    "Es256AlgorithmV1": {
      "type": "string",
      "enum": [
        "ES256"
      ]
    },
    "P256CurveV1": {
      "type": "string",
      "enum": [
        "P-256"
      ]
    },
    "Signature64": {
      "type": "string",
      "maxLength": 86,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "UtcInstant": {
      "type": "string",
      "maxLength": 24,
      "minLength": 1,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$"
    }
  }
}
