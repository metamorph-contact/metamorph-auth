{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VerifiedSignupTransferRequestV1",
  "type": "object",
  "properties": {
    "anchorProof": {
      "$ref": "#/$defs/BrowserAnchorProof"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "verifiedOutcome": {
      "$ref": "#/$defs/VerifiedSignupOutcome"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "verifiedOutcome",
    "anchorProof"
  ],
  "$defs": {
    "BrowserAnchorProof": {
      "type": "string",
      "maxLength": 2048,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "VerifiedSignupOutcome": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
