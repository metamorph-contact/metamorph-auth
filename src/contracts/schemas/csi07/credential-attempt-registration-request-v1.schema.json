{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialAttemptRegistrationRequestV1",
  "type": "object",
  "properties": {
    "attemptReceipt": {
      "$ref": "#/$defs/CredentialAttemptReceipt"
    },
    "credentialCapability": {
      "description": "Exact controller-issued capability relayed to identity home. The\ncontroller validates it against the protected receipt and flow state\nbefore retaining it as encrypted retry material.",
      "$ref": "#/$defs/RegionalCredentialCapability"
    },
    "recoveryCapability": {
      "$ref": "#/$defs/EstablishmentRecoveryCapability"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptReceipt",
    "credentialCapability",
    "recoveryCapability"
  ],
  "$defs": {
    "CredentialAttemptReceipt": {
      "type": "string",
      "maxLength": 12288,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "EstablishmentRecoveryCapability": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RegionalCredentialCapability": {
      "type": "string",
      "maxLength": 8192,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
