{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountValidationResultV1",
  "type": "object",
  "properties": {
    "browserAccountId": {
      "$ref": "#/$defs/BrowserAccountId"
    },
    "kind": {
      "$ref": "#/$defs/AccountValidationKindV1"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "browserAccountId"
  ],
  "$defs": {
    "AccountValidationKindV1": {
      "type": "string",
      "enum": [
        "current",
        "removed",
        "repairRequired"
      ]
    },
    "BrowserAccountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
