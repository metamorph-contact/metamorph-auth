{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapsuleRepairRequestV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "flowId": {
          "$ref": "#/$defs/Uuid7"
        },
        "kind": {
          "type": "string",
          "const": "begin"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "flowId"
      ]
    },
    {
      "type": "object",
      "properties": {
        "flowId": {
          "$ref": "#/$defs/Uuid7"
        },
        "homeOutcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CapsuleRecoveryOutcomeV1"
          },
          "maxItems": 8
        },
        "kind": {
          "type": "string",
          "const": "complete"
        },
        "repairHandle": {
          "$ref": "#/$defs/CapsuleRepairHandle"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "flowId",
        "repairHandle",
        "homeOutcomes"
      ]
    }
  ],
  "$defs": {
    "AccountEstablishmentOutcome": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "AccountValidationReceipt": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "CapsuleRecoveryOutcomeV1": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "current"
            },
            "outcome": {
              "$ref": "#/$defs/AccountEstablishmentOutcome"
            },
            "schemaVersion": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "schemaVersion",
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "invalid"
            },
            "outcome": {
              "$ref": "#/$defs/AccountValidationReceipt"
            },
            "schemaVersion": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "schemaVersion",
            "outcome"
          ]
        }
      ]
    },
    "CapsuleRepairHandle": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
