{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignInRequestV1",
  "type": "object",
  "properties": {
    "attemptId": {
      "$ref": "#/$defs/Uuid7"
    },
    "capability": {
      "$ref": "#/$defs/RegionalCredentialCapability"
    },
    "email": {
      "type": "string"
    },
    "password": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 1,
      "x-maxUtf8Bytes": 16384
    },
    "registrationProof": {
      "$ref": "#/$defs/RemoteOperationRegistrationProof"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "email",
    "password",
    "attemptId",
    "capability",
    "registrationProof"
  ],
  "$defs": {
    "RegionalCredentialCapability": {
      "type": "string",
      "maxLength": 8192,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RemoteOperationRegistrationProof": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
