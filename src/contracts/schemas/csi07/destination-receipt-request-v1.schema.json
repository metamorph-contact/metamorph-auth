{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DestinationReceiptRequestV1",
  "type": "object",
  "properties": {
    "receipt": {
      "$ref": "#/$defs/DestinationPreparedReceipt"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receipt"
  ],
  "$defs": {
    "DestinationPreparedReceipt": {
      "type": "string",
      "maxLength": 8192,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
