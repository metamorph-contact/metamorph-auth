{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DestinationPreparationResultV1",
  "type": "object",
  "properties": {
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "kind": {
      "$ref": "#/$defs/PreparedKindV1"
    },
    "navigationUri": {
      "type": "string"
    },
    "operationId": {
      "$ref": "#/$defs/Uuid7"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "operationId",
    "navigationUri",
    "expiresAt"
  ],
  "$defs": {
    "PreparedKindV1": {
      "type": "string",
      "enum": [
        "prepared"
      ]
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
