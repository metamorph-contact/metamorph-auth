{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SignupContinuationResultV1",
  "type": "object",
  "properties": {
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "handoff": {
      "description": "Present only for an organization-join continuation that must be\nconsumed by the destination identity region before normal signup steps.",
      "anyOf": [
        {
          "$ref": "#/$defs/SignupHandoff"
        },
        {
          "type": "null"
        }
      ]
    },
    "identityApiOrigin": {
      "$ref": "#/$defs/Origin"
    },
    "protocol": {
      "$ref": "#/$defs/SignupContinuationBindingV1"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "signupId": {
      "description": "Clear, non-authorizing path selector for the exact protected\ncontinuation. The browser must not decode the capability to discover it.",
      "$ref": "#/$defs/Uuid7"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "signupId",
    "protocol",
    "identityApiOrigin",
    "expiresAt"
  ],
  "$defs": {
    "Origin": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^https?://[^/?#]+$"
    },
    "RemoteOperationRegistrationProof": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "SignupContinuationBindingV1": {
      "type": "object",
      "properties": {
        "continuationCapability": {
          "$ref": "#/$defs/SignupContinuationCapability"
        },
        "registrationProof": {
          "$ref": "#/$defs/RemoteOperationRegistrationProof"
        }
      },
      "additionalProperties": false,
      "required": [
        "continuationCapability",
        "registrationProof"
      ]
    },
    "SignupContinuationCapability": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "SignupHandoff": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
