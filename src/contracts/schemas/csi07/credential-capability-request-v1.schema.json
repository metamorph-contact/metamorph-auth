{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialCapabilityRequestV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "signInRoute"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "schemaVersion"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "passwordRecoveryRoute"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "schemaVersion"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "signUp"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "selectedRegionId": {
          "$ref": "#/$defs/CatalogId"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "schemaVersion",
        "selectedRegionId"
      ]
    }
  ],
  "$defs": {
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    }
  }
}
