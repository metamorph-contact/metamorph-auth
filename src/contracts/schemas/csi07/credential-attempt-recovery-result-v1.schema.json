{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialAttemptRecoveryResultV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/Uuid7"
        },
        "credentialCapability": {
          "$ref": "#/$defs/RegionalCredentialCapability"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "identityApiOrigin": {
          "$ref": "#/$defs/Origin"
        },
        "kind": {
          "type": "string",
          "const": "unregistered"
        },
        "preparationRecoveryProof": {
          "$ref": "#/$defs/CredentialPreparationRecoveryProof"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "attemptId",
        "identityApiOrigin",
        "credentialCapability",
        "preparationRecoveryProof",
        "expiresAt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "attemptId": {
          "$ref": "#/$defs/Uuid7"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "identityApiOrigin": {
          "$ref": "#/$defs/Origin"
        },
        "kind": {
          "type": "string",
          "const": "recover"
        },
        "recoveryCapability": {
          "$ref": "#/$defs/EstablishmentRecoveryCapability"
        },
        "retryMaterial": {
          "$ref": "#/$defs/CredentialRetryMaterialV1"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "attemptId",
        "identityApiOrigin",
        "recoveryCapability",
        "retryMaterial",
        "expiresAt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "none"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion"
      ]
    }
  ],
  "$defs": {
    "CredentialPreparationRecoveryProof": {
      "type": "string",
      "maxLength": 24576,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "CredentialRetryMaterialV1": {
      "type": "object",
      "properties": {
        "credentialCapability": {
          "$ref": "#/$defs/RegionalCredentialCapability"
        },
        "federationFlowAuthorization": {
          "$ref": "#/$defs/FederationFlowAuthorization"
        },
        "registrationProof": {
          "$ref": "#/$defs/RemoteOperationRegistrationProof"
        }
      },
      "additionalProperties": false,
      "required": [
        "credentialCapability",
        "registrationProof",
        "federationFlowAuthorization"
      ]
    },
    "EstablishmentRecoveryCapability": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "FederationFlowAuthorization": {
      "type": "string",
      "maxLength": 12288,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Origin": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^https?://[^/?#]+$"
    },
    "RegionalCredentialCapability": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RemoteOperationRegistrationProof": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
