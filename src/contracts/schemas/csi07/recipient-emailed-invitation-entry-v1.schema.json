{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipientEmailedInvitationEntryV1",
  "description": "Original complete invitation token custody. The token's source hint is\nadvisory; only the canonical source MAC lookup admits an offer after login.",
  "type": "object",
  "properties": {
    "emailedToken": {
      "$ref": "#/$defs/RecipientEmailedToken"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "invitationId": {
      "$ref": "#/$defs/Uuid7"
    },
    "sourceRegionId": {
      "$ref": "#/$defs/CatalogId"
    }
  },
  "additionalProperties": false,
  "required": [
    "invitationId",
    "sourceRegionId",
    "emailedToken",
    "expiresAt"
  ],
  "$defs": {
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    },
    "RecipientEmailedToken": {
      "type": "string",
      "maxLength": 1024,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
