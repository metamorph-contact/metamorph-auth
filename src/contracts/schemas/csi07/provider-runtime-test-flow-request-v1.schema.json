{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderRuntimeTestFlowRequestV1",
  "type": "object",
  "properties": {
    "preparation": {
      "$ref": "#/$defs/ProviderRuntimeTestPreparation"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "validationReceipt": {
      "$ref": "#/$defs/AccountValidationReceipt"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "preparation",
    "validationReceipt"
  ],
  "$defs": {
    "AccountValidationReceipt": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "ProviderRuntimeTestPreparation": {
      "type": "string",
      "maxLength": 8192,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
