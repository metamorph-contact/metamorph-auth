{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecipientAccountAdmissionV1",
  "type": "object",
  "properties": {
    "browserAccountId": {
      "$ref": "#/$defs/BrowserAccountId"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "browserAccountId",
    "expiresAt"
  ],
  "$defs": {
    "BrowserAccountId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
