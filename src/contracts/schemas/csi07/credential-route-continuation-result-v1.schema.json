{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialRouteContinuationResultV1",
  "type": "object",
  "properties": {
    "action": {
      "$ref": "#/$defs/CredentialRouteActionV1"
    },
    "attemptId": {
      "$ref": "#/$defs/Uuid7"
    },
    "destinationCapability": {
      "$ref": "#/$defs/RegionalCredentialCapability"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "identityApiOrigin": {
      "$ref": "#/$defs/Origin"
    },
    "operationId": {
      "$ref": "#/$defs/Uuid7"
    },
    "regionId": {
      "$ref": "#/$defs/CatalogId"
    },
    "routeDecision": {
      "$ref": "#/$defs/RouteDecision"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "regionId",
    "identityApiOrigin",
    "attemptId",
    "operationId",
    "routeDecision",
    "destinationCapability",
    "expiresAt"
  ],
  "$defs": {
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    },
    "CredentialRouteActionV1": {
      "type": "string",
      "enum": [
        "signIn",
        "passwordRecoveryRequest"
      ]
    },
    "Origin": {
      "type": "string",
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^https?://[^/?#]+$"
    },
    "RegionalCredentialCapability": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RouteDecision": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
