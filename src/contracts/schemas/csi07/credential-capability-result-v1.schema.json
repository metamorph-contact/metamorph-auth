{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialCapabilityResultV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "signInRoute"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "routeCapability": {
          "$ref": "#/$defs/RegionalRouteCapability"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "schemaVersion",
        "routeCapability",
        "expiresAt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "federationRoute"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "routeCapability": {
          "$ref": "#/$defs/RegionalRouteCapability"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "schemaVersion",
        "routeCapability",
        "expiresAt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "socialRoute"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "federationFlowAuthorization": {
          "$ref": "#/$defs/FederationFlowAuthorization"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "schemaVersion",
        "federationFlowAuthorization",
        "expiresAt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "passwordRecoveryRoute"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "routeCapability": {
          "$ref": "#/$defs/RegionalRouteCapability"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "schemaVersion",
        "routeCapability",
        "expiresAt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "const": "signUp"
        },
        "destinationCapability": {
          "$ref": "#/$defs/RegionalCredentialCapability"
        },
        "establishmentOperationId": {
          "$ref": "#/$defs/Uuid7"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "schemaVersion",
        "establishmentOperationId",
        "destinationCapability",
        "expiresAt"
      ]
    }
  ],
  "$defs": {
    "FederationFlowAuthorization": {
      "type": "string",
      "maxLength": 12288,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RegionalCredentialCapability": {
      "type": "string",
      "maxLength": 8192,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RegionalRouteCapability": {
      "type": "string",
      "maxLength": 3072,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
