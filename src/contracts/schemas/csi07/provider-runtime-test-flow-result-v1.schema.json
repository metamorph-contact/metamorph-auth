{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProviderRuntimeTestFlowResultV1",
  "type": "object",
  "properties": {
    "authorization": {
      "$ref": "#/$defs/FederationFlowAuthorization"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "flowId": {
      "$ref": "#/$defs/Uuid7"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "flowId",
    "authorization",
    "expiresAt"
  ],
  "$defs": {
    "FederationFlowAuthorization": {
      "type": "string",
      "maxLength": 12288,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
