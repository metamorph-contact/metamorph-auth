{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BrowserStartRequestV1",
  "type": "object",
  "properties": {
    "adoptionReceipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/SignupAdoptionReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "browserInitializationId": {
      "$ref": "#/$defs/BrowserInitializationId"
    },
    "clientId": {
      "$ref": "#/$defs/CatalogId"
    },
    "emailedInvitation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecipientEmailedInvitationEntryV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "intent": {
      "$ref": "#/$defs/AuthenticationIntentV1"
    },
    "locale": {
      "$ref": "#/$defs/Locale"
    },
    "providerTestEntry": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProviderRuntimeTestEntryV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "returnId": {
      "$ref": "#/$defs/RelativeReturnId"
    },
    "samlHandoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/SamlHandoffEntryV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "tabTransactionId": {
      "$ref": "#/$defs/Secret32"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "clientId",
    "browserInitializationId",
    "tabTransactionId",
    "returnId",
    "locale",
    "intent"
  ],
  "$defs": {
    "AuthenticationIntentV1": {
      "type": "string",
      "enum": [
        "signIn",
        "signUp",
        "addAccount",
        "switchAccount",
        "continueSignup"
      ]
    },
    "BrowserInitializationId": {
      "type": "string",
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    },
    "Locale": {
      "type": "string",
      "maxLength": 35,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$"
    },
    "ProviderRuntimeTestEntryV1": {
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "preparation": {
          "$ref": "#/$defs/ProviderRuntimeTestPreparation"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "testId": {
          "$ref": "#/$defs/Uuid7"
        }
      },
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "testId",
        "preparation",
        "expiresAt"
      ]
    },
    "ProviderRuntimeTestPreparation": {
      "type": "string",
      "maxLength": 8192,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RecipientEmailedInvitationEntryV1": {
      "description": "Original complete invitation token custody. The token's source hint is\nadvisory; only the canonical source MAC lookup admits an offer after login.",
      "type": "object",
      "properties": {
        "emailedToken": {
          "$ref": "#/$defs/RecipientEmailedToken"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "invitationId": {
          "$ref": "#/$defs/Uuid7"
        },
        "sourceRegionId": {
          "$ref": "#/$defs/CatalogId"
        }
      },
      "additionalProperties": false,
      "required": [
        "invitationId",
        "sourceRegionId",
        "emailedToken",
        "expiresAt"
      ]
    },
    "RecipientEmailedToken": {
      "type": "string",
      "maxLength": 1024,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "RelativeReturnId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9._-]+$"
    },
    "SamlHandoffEntryV1": {
      "description": "Opaque unsolicited assertion custody. This is start metadata, never\nauthentication evidence; I admits its original retained proof separately.",
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "handoffProof": {
          "$ref": "#/$defs/Secret32"
        },
        "providerRegionId": {
          "$ref": "#/$defs/CatalogId"
        }
      },
      "additionalProperties": false,
      "required": [
        "handoffProof",
        "providerRegionId",
        "expiresAt"
      ]
    },
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "SignupAdoptionReceipt": {
      "type": "string",
      "maxLength": 2048,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
