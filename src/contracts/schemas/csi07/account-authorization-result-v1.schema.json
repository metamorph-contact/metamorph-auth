{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountAuthorizationResultV1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "kind": {
          "type": "string",
          "const": "prepared"
        },
        "preparation": {
          "$ref": "#/$defs/HomePreparation"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "preparation",
        "expiresAt"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "invalid"
        },
        "outcome": {
          "$ref": "#/$defs/AccountValidationReceipt"
        },
        "schemaVersion": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "validationAttemptId": {
          "$ref": "#/$defs/Uuid7"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "schemaVersion",
        "validationAttemptId",
        "outcome"
      ]
    }
  ],
  "$defs": {
    "AccountValidationReceipt": {
      "type": "string",
      "maxLength": 6144,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "HomePreparation": {
      "type": "string",
      "maxLength": 18432,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
