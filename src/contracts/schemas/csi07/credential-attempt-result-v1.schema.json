{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialAttemptResultV1",
  "type": "object",
  "properties": {
    "attemptReceipt": {
      "$ref": "#/$defs/CredentialAttemptReceipt"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "recoveryCapability": {
      "$ref": "#/$defs/EstablishmentRecoveryCapability"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptReceipt",
    "recoveryCapability",
    "expiresAt"
  ],
  "$defs": {
    "CredentialAttemptReceipt": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    },
    "EstablishmentRecoveryCapability": {
      "type": "string",
      "maxLength": 4096,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
