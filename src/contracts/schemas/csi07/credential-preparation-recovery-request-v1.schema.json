{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialPreparationRecoveryRequestV1",
  "type": "object",
  "properties": {
    "preparationRecoveryProof": {
      "$ref": "#/$defs/CredentialPreparationRecoveryProof"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "preparationRecoveryProof"
  ],
  "$defs": {
    "CredentialPreparationRecoveryProof": {
      "type": "string",
      "maxLength": 24576,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
