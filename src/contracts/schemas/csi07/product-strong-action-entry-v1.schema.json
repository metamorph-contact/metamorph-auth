{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductStrongActionEntryV1",
  "description": "Product-owned, non-authorizing launch metadata for one exact strong action.\nThe target digest is prepared by the authenticated product API; H still\nrechecks the selected CSI account, current policy, operation, target and\none-use proof when the eventual mutation commits.",
  "type": "object",
  "properties": {
    "attemptId": {
      "$ref": "#/$defs/Uuid7"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "operationKey": {
      "$ref": "#/$defs/CatalogId"
    },
    "resultNonce": {
      "$ref": "#/$defs/Secret32"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "targetDigest": {
      "$ref": "#/$defs/Digest32"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "attemptId",
    "operationKey",
    "targetDigest",
    "resultNonce",
    "expiresAt"
  ],
  "$defs": {
    "CatalogId": {
      "type": "string",
      "maxLength": 96,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9]|[._-](?=[a-z0-9])){0,95}$"
    },
    "Digest32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Secret32": {
      "type": "string",
      "maxLength": 43,
      "minLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "Uuid7": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
