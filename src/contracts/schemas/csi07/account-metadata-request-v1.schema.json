{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccountMetadataRequestV1",
  "type": "object",
  "properties": {
    "capability": {
      "$ref": "#/$defs/AccountMetadataCapability"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability"
  ],
  "$defs": {
    "AccountMetadataCapability": {
      "type": "string",
      "maxLength": 16384,
      "minLength": 5,
      "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]*){2}(?:(?:\\.[A-Za-z0-9_-]*){2})?$"
    }
  }
}
